# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as a template they aren't stored
# in version control. Keep this commented out if your .spec is committed
# intentionally (as with a hand-written spec).
# *.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*

# Tooling / editor
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
